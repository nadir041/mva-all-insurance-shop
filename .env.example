# Copy to `.env` (or set in your hosting provider) to override defaults.
# Only variables prefixed with VITE_ are exposed to the browser — never put secrets here.

# Where the lead form POSTs its multipart FormData.
# Default matches the original site: a same-origin POST to /mva.aspx.
VITE_CLAIM_ENDPOINT=/mva.aspx

# Public origin used for canonical URLs and social metadata.
VITE_SITE_URL=https://mvaclaims.allinsuranceshop.com
